{
  "name": "chrome-agent",
  "version": "0.1.0",
  "description": "Ultra-low-latency headless-first agentic browser: a Chrome CLI for parallel AI agents over raw CDP",
  "type": "module",
  "bin": {
    "chrome-agent": "./bin/chrome-agent.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "node dist/test/e2e.js",
    "bench": "node dist/bench/run.js",
    "bench:chrome": "node dist/bench/run.js --engine chrome",
    "daemon": "node dist/daemon.js",
    "mcp": "node dist/mcp.js",
    "test-site": "node dist/test-site/server.js",
    "prepare": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "README.md"
  ]
}
